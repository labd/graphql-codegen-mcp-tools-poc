{
	"name": "graphql-mcp-tools",
	"version": "0.1.0",
	"description": "Generate MCP tool definitions from GraphQL operations",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./codegen": "./src/codegen/index.ts",
		"./codegen/tools": "./src/codegen/tools-plugin.ts",
		"./runtime": "./src/runtime/index.ts",
		"./directives.graphql": "./src/directives.graphql"
	},
	"packageManager": "pnpm@12.12.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"codegen": "graphql-codegen --config example/codegen.ts && tsx example/generate-tools.ts",
		"example": "tsx example/server.ts",
		"format": "biome check --write",
		"lint": "biome ci",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"change-case": "^5.4.4",
		"graphql": "^17.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/client-preset": "^6.2.3",
		"@graphql-codegen/plugin-helpers": "^7.4.2",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@types/node": "^26.6.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"private": true
}
